    {
      "id": "claim_189ef6e41b0744869c28564e59ee8694",
      "statement": "Flask exposes current_app and g through LocalProxy objects backed by the app ContextVar, and request and session through proxies backed by the request ContextVar; accessing an unbound proxy raises a context-specific RuntimeError.",
